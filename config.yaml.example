# Copy to config.yaml. Keep credentials in .env, never in a shared report.
# Each profile is independently selectable. Tencent defaults to ASR 2.0.
models:
  - profile_id: tencent_v2
    name: 腾讯大模型 2.0
    provider: tencent_v2
    params:
      app_id: "${TENCENT_APP_ID}"
      secret_id: "${TENCENT_SECRET_ID}"
      secret_key: "${TENCENT_SECRET_KEY}"
      engine_model_type: 16k_zh_en_2.0
      filter_modal: 0
  - profile_id: volcengine
    name: 火山大模型
    provider: volcengine
    params:
      app_key: "${VOLCENGINE_APP_KEY}"
      access_key: "${VOLCENGINE_ACCESS_KEY}"
      resource_id: volc.bigasr.sauc.duration
      ws_url: wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
  - profile_id: funasr
    name: 阿里 FunASR
    provider: funasr
    params:
      api_key: "${DASHSCOPE_API_KEY}"
      model: fun-asr-realtime
  - profile_id: qwen_asr
    name: 阿里 Qwen ASR
    provider: qwen_asr
    params:
      api_key: "${DASHSCOPE_API_KEY}"
      model: qwen3-asr-flash-realtime
  - profile_id: paraformer
    name: 阿里 Paraformer
    provider: paraformer
    params:
      api_key: "${DASHSCOPE_API_KEY}"
      model: paraformer-realtime-v2
  - profile_id: eot_llm
    name: 语义 EOT 模型
    provider: eot_chat
    params:
      base_url: "${EOT_BASE_URL}"  # e.g. http://localhost:8000/v1
      model: "${EOT_MODEL}"
      api_key: "${EOT_API_KEY}"    # Remove this field for an unauthenticated local endpoint
      max_tokens: 4
      temperature: 0
      timeout: 30
      # For a model requiring thinking to be disabled:
      # extra_body:
      #   chat_template_kwargs: {enable_thinking: false}
